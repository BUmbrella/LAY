<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Resource\LYA_icon.ico</ApplicationIcon>
    <Platforms>AnyCPU;x64</Platforms>
    <DefaultItemExcludes>$(DefaultItemExcludes);publish\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime.Gpu" Version="1.26.0" />
    <PackageReference Include="OpenCvSharp4" Version="4.13.0.20260531" />
    <PackageReference Include="OpenCvSharp4.Extensions" Version="4.13.0.20260531" />
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.13.0.20260531" />
    <PackageReference Include="Prism.Unity" Version="9.0.537" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Resource\APS.png" />
    <None Remove="Resource\LYA_logo.png" />
    <None Remove="Resource\LYA_icon.ico" />
    <None Remove="Resource\LYA_icon_256.png" />
    <Reference Include="LAY.Project">
      <HintPath>bin\x64\Debug\net8.0-windows\onnx\LAY.Project.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Resource Include="Resource\APS.png" />
    <Resource Include="Resource\LYA_logo.png" />
    <Resource Include="Resource\LYA_icon.ico" />
    <Resource Include="Resource\LYA_icon_256.png" />
  </ItemGroup>

</Project>




